/target

# Vendored FFmpeg: the clone (~630 MB) and the built static libs are
# reproducible from scripts/build-ffmpeg.sh -- never versioned. The glob covers
# every install prefix (ffmpeg-install, ffmpeg-install-net, ...).
/third_party/ffmpeg/
/third_party/ffmpeg-install*/

# Test artifacts: downloaded media, ONNX models, generated transcripts.
/test-data/
/models/

# Build output: the .deb is produced by packaging/build-deb.sh, and the .sha256
# is what a release publishes next to it.
/*.deb
/*.deb.sha256

# Windows cross build (FFmpeg for mingw; see scripts/build-ffmpeg-win.sh).
/third_party/ffmpeg-win-install/
/third_party/ffmpeg-win-build/

# Cross-build bundle (exe + dll + model), produced locally.
/dist/
